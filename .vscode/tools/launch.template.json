{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "debugpy",
            "request": "launch",
            "python": "${config:python.defaultInterpreterPath}",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src:${env:PYTHONPATH}",
                "PYTHONUNBUFFERED": "1"
            },
            "name": "Python: Current File",
            "program": "${file}"
        },
        {
            "name": "Navigation: Spawn Simulation",
            "type": "debugpy",
            "request": "launch",
            "python": "${config:python.defaultInterpreterPath}",
            "program": "${workspaceFolder}/src/navigation_data_synthesis/spawn_simulation_sence.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "args": [
                "--/persistent/renderer/startupMessageDisplayed=true"
            ],
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src:${env:PYTHONPATH}",
                "PYTHONUNBUFFERED": "1"
            }
        },
        {
            "name": "Python: Debugger Attach",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "127.0.0.1",
                "port": 3000
            },
            "justMyCode": false
        },
        {
            "type": "debugpy",
            "request": "launch",
            "python": "${config:python.defaultInterpreterPath}",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src:${env:PYTHONPATH}",
                "PYTHONUNBUFFERED": "1"
            },
            "name": "Python: Train Environment",
            "program": "${workspaceFolder}/env_isaaclab/bin/isaaclab",
            "args": [
                "train",
                "--task",
                "Isaac-Cartpole",
                "--num_envs",
                "64",
                "--visualizer",
                "none"
            ]
        },
        {
            "type": "debugpy",
            "request": "launch",
            "python": "${config:python.defaultInterpreterPath}",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src:${env:PYTHONPATH}",
                "PYTHONUNBUFFERED": "1"
            },
            "name": "Python: Play Environment",
            "program": "${workspaceFolder}/env_isaaclab/bin/isaaclab",
            "args": [
                "play",
                "--task",
                "Isaac-Cartpole",
                "--num_envs",
                "32",
                "--visualizer",
                "none"
            ]
        },
        {
            "type": "debugpy",
            "request": "launch",
            "python": "${config:python.defaultInterpreterPath}",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src:${env:PYTHONPATH}",
                "PYTHONUNBUFFERED": "1",
                "PYTEST_DISABLE_PLUGIN_AUTOLOAD": "1",
                "PYTEST_PLUGINS": "pytest_mock"
            },
            "name": "Python: SinglePytest",
            "module": "pytest",
            "args": [
                "-v",
                "-s",
                "${file}"
            ]
        },
        {
            "type": "debugpy",
            "request": "launch",
            "python": "${config:python.defaultInterpreterPath}",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src:${env:PYTHONPATH}",
                "PYTHONUNBUFFERED": "1"
            },
            "name": "Python: ALL Pytest",
            "module": "pytest",
            "args": [
                "tools"
            ],
            "subProcess": false
        }
    ]
}
